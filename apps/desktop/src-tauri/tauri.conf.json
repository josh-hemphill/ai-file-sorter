{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI File Sorter",
  "version": "0.1.0",
  "identifier": "app.filesorter.desktop",
  "build": {
    "beforeDevCommand": "cargo engine-bins --manifest-path ../../Cargo.toml && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cargo engine-bins --manifest-path ../../Cargo.toml --release && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI File Sorter",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost https://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost https://asset.localhost data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/henry.w@example.net"
    ],
    "externalBin": [
      "binaries/aifs-engine",
      "binaries/aifs-worker-media",
      "binaries/aifs-worker-document",
      "binaries/aifs-worker-vision",
      "binaries/aifs-worker-llm"
    ]
  }
}
