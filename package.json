{
  "name": "aifs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "scripts": {
    "build": "cargo engine-bins",
    "llama": "node scripts/with-cmake-generator.mjs cargo engine-llm",
    "llama:cuda": "node scripts/with-llm-features.mjs cuda pnpm llama",
    "llama:vulkan": "node scripts/with-llm-features.mjs vulkan pnpm llama",
    "llama:metal": "node scripts/with-llm-features.mjs metal pnpm llama",
    "fmt": "cargo fmt --all",
    "fmt:check": "cargo fmt --all --check",
    "clippy": "cargo clippy --workspace --all-targets",
    "test": "pnpm build && cargo test --workspace",
    "test:desktop": "node --test scripts/workspace.test.mjs scripts/windows-cmake-generator.test.mjs scripts/llama-cuda-env.test.mjs scripts/packaged-ggml.test.mjs scripts/llm-features.test.mjs && pnpm --filter desktop test && pnpm --filter desktop exec vue-tsc --noEmit",
    "check": "pnpm fmt:check && pnpm clippy && pnpm test",
    "desktop": "pnpm build && pnpm llama && pnpm --filter desktop tauri dev",
    "desktop:cuda": "node scripts/with-llm-features.mjs cuda pnpm desktop",
    "desktop:vulkan": "node scripts/with-llm-features.mjs vulkan pnpm desktop",
    "desktop:metal": "node scripts/with-llm-features.mjs metal pnpm desktop",
    "cli": "cargo aifs"
  }
}
